{
  "name": "creative-production-pipeline",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "bun --cwd apps/api run dev",
    "dev:dashboard": "bun --cwd apps/dashboard run dev",
    "test": "bun test",
    "typecheck": "bun run --filter='*' typecheck"
  },
  "devDependencies": {
    "bullmq": "^5.21.0",
    "ioredis": "^5.4.0",
    "sharp": "^0.33.5",
    "socket.io": "^4.8.0",
    "socket.io-client": "^4.8.0",
    "typescript": "^5.6.0"
  }
}
