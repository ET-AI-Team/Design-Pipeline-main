# --- Database (ADR-008, Supabase) ---
# Pooled connection (runtime queries). connection_limit caps how many
# connections Prisma itself opens against the pgbouncer pooler — confirm
# this fits your Supabase plan's own pooler ceiling before raising worker
# concurrency below.
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true&connection_limit=20"
# Direct connection (migrations only — Supabase recommends bypassing the pooler for these)
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# --- Redis / BullMQ (ADR-005) ---
REDIS_URL="redis://localhost:6379"

# --- Image generation provider (Gemini / "Nano Banana" family) ---
GEMINI_API_KEY=""
# Confirmed live-callable against the real API as of 2026-08-14 (Phase 3).
# No fallback value exists in code — startup validation fails hard if
# unset, so a stale/guessed model string can never silently ship. If
# these ever stop working, re-verify against GET /v1beta/models before
# changing them, don't just guess a new string.
GEMINI_FLASH_MODEL="gemini-3.1-flash-image"
# Used by dimension_* (all three) and, as of the base-layer-classification
# change, base_asset too - the structured, classifier-informed prompt is a
# harder instruction-following task than Flash was validated against.
GEMINI_PRO_MODEL="gemini-3-pro-image"

# --- Vision / scoring provider (OpenAI) ---
OPENAI_API_KEY=""
# Same rule as above — confirmed live as of 2026-08-14. This account also
# has GPT-5.x access now, which didn't exist when the design docs were
# written; gpt-4.1 is kept deliberately (see NFR's cost model + the
# "judge is a different model than the generator" reasoning), not because
# nothing newer is available.
OPENAI_VISION_MODEL="gpt-4.1"
# Confirmed live against GET /v1/models as of 2026-08-19: gpt-image-1,
# gpt-image-1-mini, gpt-image-1.5, gpt-image-2, and a dated
# gpt-image-2-2026-04-21 snapshot are all available on this account.
# gpt-image-2 (the latest un-dated alias, same convention as
# GEMINI_PRO_MODEL/OPENAI_VISION_MODEL above) is used - quality is the
# priority for this call, not cost. Confirmed live-callable against the
# real /v1/images/edits endpoint with a real mask before this was wired
# into any production code path.
OPENAI_IMAGE_EDIT_MODEL="gpt-image-2"

# --- Cloudinary (asset storage) ---
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- App ---
PORT="4000"
NODE_ENV="development"

# --- Scaling knobs ---
# Both BullMQ workers defaulted to concurrency 1 (BullMQ's own default,
# never overridden) — every image-generation job (base_asset AND all 3
# dimension_* stages) ran strictly one at a time, system-wide. Start
# moderate and raise once real provider latency/error rates at that level
# look stable in the logs; each also needs the corresponding provider
# account to actually sustain that many simultaneous calls.
IMAGE_GEN_CONCURRENCY="8"
VISION_SCORING_CONCURRENCY="8"
# Caps concurrent POST /:id/edit executions (the one endpoint with no
# queue/concurrency control at all otherwise) — excess calls wait their
# turn rather than firing uncapped simultaneous provider calls.
EDIT_CONCURRENCY="8"
# Caps concurrent background reference-upload groups on job creation.
JOB_UPLOAD_CONCURRENCY="4"

# How long a StageAttempt may sit in-flight (completedAt: null) before
# the orphan reaper escalates it so it becomes retryable. Must stay well
# above the slowest legitimate window: stage p90s are 51-84s, BullMQ's
# lockDuration is 300s, and a queued attempt can wait ~13 min behind a
# 30-job burst at concurrency 8.
ORPHAN_REAP_AFTER_MINUTES="20"
